---
import Navbar from './Navbar.astro';
import ProjectDetail from './ProjectDetail.astro';
import ProjectImage from './ProjectImage.astro';
import ProjectNext from './ProjectNext.astro';
import SiteBrand from './SiteBrand.astro';
import { ikeneasWorkName, projectCategories, type ProjectCategory } from '../data/projects';
import ikeneasData from '../content/ikeneas.json';

const tableCategories = Object.entries(projectCategories) as Array<[string, ProjectCategory]>;
const allProjects = Object.values(projectCategories).flatMap((group) => group.projects);
const projectsWithImages = allProjects.filter((project) => project.images?.length);
const ikeneasCategory = projectCategories.category_ikeneas;
const ikeneasWorkUrl = ikeneasData.work_url || ikeneasData.url;
---

<section id="work" class="work-slide" data-depth="0">
	{/* ── Capa 0: menú de categorías ── */}
	<div class="work-layer work-layer--menu" data-layer="0">
		<div class="work-grid" data-v-scroll>
			<div class="work-row-spacer" aria-hidden="true"></div>
			<button
				type="button"
				class="work-link hover-branding work-row work-row--white work-row--branding"
				data-open-category={projectCategories.category_1.slug}
				data-cursor-nav
				style={`--work-hover-bg: ${projectCategories.category_1.hoverColor};`}
			>
				<span class="work-txt work-txt--xl work-txt--branding work-txt--dark" style="--work-reveal-delay: 40ms;">{projectCategories.category_1.title}</span>
			</button>

			<button
				type="button"
				class="work-link hover-proyectos work-row work-row--gray work-row--branding"
				data-open-category={projectCategories.category_2.slug}
				data-cursor-nav
				aria-label="social media"
				style={`--work-hover-bg: ${projectCategories.category_2.hoverColor};`}
			>
				<span class="work-txt work-txt--xl work-txt--branding work-txt--dark" style="--work-reveal-delay: 115ms;">{projectCategories.category_2.title}</span>
			</button>

			<div class="work-row-pair">
				<button
					type="button"
					class="work-link hover-flyers work-row work-row--white work-row--branding"
					data-open-category={projectCategories.category_3.slug}
					data-cursor-nav
					style={`--work-hover-bg: ${projectCategories.category_3.hoverColor};`}
				>
					<span class="work-txt work-txt--xl work-txt--branding work-txt--dark" style="--work-reveal-delay: 190ms;">{projectCategories.category_3.title}</span>
				</button>

				<button
					type="button"
					class="work-link hover-merch work-row work-row--white work-row--branding"
					data-open-category={projectCategories.category_4.slug}
					data-cursor-nav
					style={`--work-hover-bg: ${projectCategories.category_4.hoverColor};`}
				>
					<span class="work-txt work-txt--xl work-txt--branding work-txt--dark" style="--work-reveal-delay: 265ms;">{projectCategories.category_4.title}</span>
				</button>
			</div>

			{ikeneasCategory ? (
				<button
					type="button"
					class="work-link hover-ikeneas work-row work-row--gray work-row--branding"
					data-open-category={ikeneasCategory.slug}
					data-cursor-nav
					style={`--work-hover-bg: ${ikeneasCategory.hoverColor};`}
				>
					<span class="work-txt work-txt--xl work-txt--branding work-txt--dark" style="--work-reveal-delay: 340ms;">{ikeneasCategory.title.toUpperCase()}</span>
				</button>
			) : (
				<button
					type="button"
					class="work-link hover-ikeneas work-row work-row--gray work-row--branding"
					data-external-url={ikeneasWorkUrl}
					data-cursor-nav
					style={`--work-hover-bg: ${ikeneasData.hover_color};`}
				>
					<span class="work-txt work-txt--xl work-txt--branding work-txt--dark" style="--work-reveal-delay: 340ms;">{ikeneasWorkName.toUpperCase()}</span>
				</button>
			)}
		</div>

		<div class="work-nav">
			<div class="work-nav__inner">
				<Navbar theme="dark" active="work" />
			</div>
		</div>
	</div>

	{/* ── Capa 1: tablas de categoría (pre-renderizadas) ── */}
	<div class="work-layer work-layer--category" data-layer="1" aria-hidden="true" inert>
		{tableCategories.map(([category, group]) => (
			<div
				class="category-panel"
				data-category={group.slug}
				id={group.slug}
				data-v-scroll
				hidden
			>
				<header class="category-nav">
					<a href="/" class="category__name-title" aria-label="Ir al inicio"><SiteBrand /></a>
					<Navbar theme="dark" active="work" />
				</header>

				<div class="category-content">
					<h1 class="category-title">{group.title}</h1>
					<div class="category-separator"></div>
					<div class="project-list">
						{group.projects.map((project) => (
							<button
								type="button"
								class="project-row"
								style={`--hover-bg: ${project.color};`}
								data-open-project={project.slug}
								data-from-category={group.slug}
							>
								<div class="col-id">{project.id}</div>
								<div class="col-name">
									<span class="color-square" style={`background-color: ${project.color};`}></span>
									<span class="name-text">{project.name}</span>
								</div>
								<div class="col-year">{project.year}</div>
								<div class="col-location">{project.location}</div>
							</button>
						))}
					</div>
					<div class="category-footer">
						<div class="category-bottom-nav">
							<button
								type="button"
								class="category__nav-btn"
								data-nav-back
							>
								<span class="category__nav-icon" aria-hidden="true">←</span>
								<span class="category__nav-text--desktop">BACK</span>
								<span class="category__nav-text--mobile">BACK</span>
							</button>
						</div>
						<div class="category-pagination" data-category-pagination aria-label="Paginación de proyectos">
							<button type="button" class="category-pagination__btn" data-category-page="prev" aria-label="Página anterior">
								<span aria-hidden="true">←</span>
							</button>
							<span class="category-pagination__status" data-category-page-status>1 / 1</span>
							<button type="button" class="category-pagination__btn" data-category-page="next" aria-label="Página siguiente">
								<span aria-hidden="true">→</span>
							</button>
						</div>
					</div>
				</div>
			</div>
		))}
	</div>

	{/* ── Capa 2: detalles de proyecto (pre-renderizadas) ── */}
	<div class="work-layer work-layer--project" data-layer="2" aria-hidden="true" inert>
		{allProjects.map((project) => (
			<ProjectDetail project={project} />
		))}
	</div>

	{/* ── Capa 3: imágenes a pantalla completa (carrusel por proyecto) ── */}
	<div class="work-layer work-layer--images" data-layer="3" aria-hidden="true" inert>
		{projectsWithImages.map((project) => (
			<ProjectImage project={project} />
		))}
	</div>

	{/* ── Capa 4: siguientes proyectos según el actual ── */}
	<div class="work-layer work-layer--next" data-layer="4" aria-hidden="true" inert>
		{allProjects.map((project) => (
			<ProjectNext project={project} />
		))}
	</div>
</section>

<script>
	// @ts-nocheck
	const root = document.getElementById('work');
	if (root) {
		const layerCategory = root.querySelector('.work-layer--category');
		const layerProject = root.querySelector('.work-layer--project');
		const layerImages = root.querySelector('.work-layer--images');
		const layerNext = root.querySelector('.work-layer--next');

		const categoryPanels = () =>
			Array.from(root.querySelectorAll('[data-category]'));
		const projectPanels = () =>
			Array.from(root.querySelectorAll('[data-project]'));
		const imagePanels = () =>
			Array.from(root.querySelectorAll('[data-project-image]'));
		const nextPanels = () =>
			Array.from(root.querySelectorAll('[data-project-next]'));
		const imageHydration = new WeakMap();
		let imageOpenRequest = 0;
		let currentImagePanel = null;
		let imageTransitionTimer = 0;

		function imagePanelFor(slug) {
			return imagePanels().find(
				(el) => el.getAttribute('data-project-image') === slug
			);
		}

		function markImageReady(image) {
			image.classList.add('is-ready');
			image.closest('.project-image__figure, .project-next__media')?.classList.add('is-ready');
		}

		/** Asigna src y espera decode para no pintar un frame vacío. 
		 * OPTIMIZADO: Añade timeout de seguridad y resuelve más rápido para no bloquear UI */
		function hydrateImage(image) {
			if (!(image instanceof HTMLImageElement) && !(image instanceof HTMLVideoElement)) return Promise.resolve();
			const cached = imageHydration.get(image);
			if (cached) return cached;

			const src = image.getAttribute('src') || image.dataset.src;
			if (!src) return Promise.resolve();

			const prepared = new Promise((resolve) => {
				// Timeout de seguridad: si después de 3 segundos no cargó, resolvemos igual
				const safetyTimeout = setTimeout(() => {
					console.warn('[hydrateImage] Timeout alcanzado para imagen:', src);
					markImageReady(image);
					resolve();
				}, 3000);

				const finish = () => {
					clearTimeout(safetyTimeout);
					markImageReady(image);
					resolve();
				};

				if (image instanceof HTMLVideoElement) {
					if (image.getAttribute('src') !== src) {
						image.src = src;
						image.load();
					}
					if (image.readyState >= 2) {
						finish();
					} else {
						image.addEventListener('loadeddata', finish, { once: true });
						image.addEventListener('error', finish, { once: true });
					}
					return;
				}

				const decode = () => {
					const decoded = image.decode?.();
					if (decoded) {
						decoded.catch(() => undefined).finally(finish);
					} else {
						finish();
					}
				};

				if (image.getAttribute('src') !== src) {
					image.src = src;
				}

				if (image.complete && image.naturalWidth > 0) {
					decode();
					return;
				}

				const onLoad = () => {
					image.removeEventListener('error', onError);
					decode();
				};
				const onError = () => {
					image.removeEventListener('load', onLoad);
					resolve();
				};

				image.addEventListener('load', onLoad, { once: true });
				image.addEventListener('error', onError, { once: true });
				if (image.complete) {
					image.removeEventListener('load', onLoad);
					image.removeEventListener('error', onError);
					if (image.naturalWidth > 0) decode();
				}
			});

			imageHydration.set(image, prepared);
			return prepared;
		}

		const PAIR = 2;
		const nextPreviewReady = new Map();
		function getCategoryMaxPageSize() {
			return window.innerWidth <= 700 ? 15 : 8;
		}
		const categoryPaginationObservers = new WeakMap();

		function galleryImages(panel) {
			return Array.from(panel.querySelectorAll('.project-image__img'));
		}

		function galleryIndexFromScroll(gallery) {
			const figures = Array.from(gallery.querySelectorAll('.project-image__figure'));
			if (figures.length === 0) return 0;
			const center = gallery.scrollLeft + gallery.clientWidth / 2;
			let current = 0;
			let bestDist = Infinity;
			figures.forEach((figure, i) => {
				const mid = figure.offsetLeft + figure.offsetWidth / 2;
				const dist = Math.abs(mid - center);
				if (dist < bestDist) {
					bestDist = dist;
					current = i;
				}
			});
			return current;
		}

		function pairStart(index) {
			return Math.max(0, index - (index % PAIR));
		}

		function loadPair(images, start) {
			if (!images.length || start >= images.length) return Promise.resolve();
			const jobs = [];
			for (let i = start; i < start + PAIR && i < images.length; i++) {
				jobs.push(hydrateImage(images[i]));
			}
			return Promise.all(jobs);
		}

		function ensurePairs(images, index) {
			const base = pairStart(index);
			const current = loadPair(images, base);
			void loadPair(images, base + PAIR);
			return current;
		}

		function nextPanelFor(slug) {
			return nextPanels().find((el) => el.getAttribute('data-project-next') === slug);
		}

		function relatedSlugs(slug) {
			const panel = nextPanelFor(slug);
			return (panel?.getAttribute('data-related') || '').split(',').filter(Boolean);
		}

		function nextThumbImages(panel) {
			return Array.from(panel.querySelectorAll('.project-next__media img'));
		}

		function prepareNextThumbs(panel) {
			if (!(panel instanceof HTMLElement)) return Promise.resolve();
			return Promise.all(nextThumbImages(panel).map((image) => hydrateImage(image)));
		}

		function ensureNextPreviews(slug) {
			if (!slug) return Promise.resolve();
			const cached = nextPreviewReady.get(slug);
			if (cached) return cached;

			const panel = nextPanelFor(slug);
			if (!panel) return Promise.resolve();

			const ready = prepareNextThumbs(panel);
			nextPreviewReady.set(slug, ready);
			return ready;
		}

		function maybePrefetchNext(slug, images, index) {
			if (!slug || !images.length) return;
			const start = pairStart(index);
			const threshold = Math.max(0, images.length - PAIR * 2);
			if (start >= threshold) void ensureNextPreviews(slug);
		}

		function clamp(n, min, max) {
			return Math.min(max, Math.max(min, n));
		}

		function categoryPageSize(panel) {
			const maxPage = getCategoryMaxPageSize();
			if (!(panel instanceof HTMLElement)) return maxPage;
			const value = Number(panel.dataset.pageSize || maxPage);
			return Math.max(1, Math.min(maxPage, value || maxPage));
		}

		function initCategoryPagination(panel) {
			if (!(panel instanceof HTMLElement)) return;
			if (panel.dataset.paginationBound === '1') return;
			panel.dataset.paginationBound = '1';

			const rows = Array.from(panel.querySelectorAll('.project-row'));
			const totalPages = Math.max(1, Math.ceil(rows.length / categoryPageSize(panel)));
			panel.dataset.pageCount = String(totalPages);
			panel.dataset.pageIndex = panel.dataset.pageIndex || '0';

			const pager = panel.querySelector('[data-category-pagination]');
			if (pager instanceof HTMLElement) {
				if (totalPages <= 1) pager.setAttribute('hidden', '');
				else pager.removeAttribute('hidden');
			}

			// Recalcula el tamaño de página si cambia el viewport (móvil/desktop,
			// barra del navegador, etc.) para evitar que aparezca scroll vertical.
			if ('ResizeObserver' in window && !categoryPaginationObservers.get(panel)) {
				const observer = new ResizeObserver(() => {
					if (panel.hidden) return;
					requestAnimationFrame(() => {
						autoFitCategoryPageSize(panel);
					});
				});
				observer.observe(panel);
				categoryPaginationObservers.set(panel, observer);
			}
		}

		function setCategoryPage(panel, pageIndex) {
			if (!(panel instanceof HTMLElement)) return;
			initCategoryPagination(panel);

			const rows = Array.from(panel.querySelectorAll('.project-row'));
			const totalPages = Number(panel.dataset.pageCount || '1') || 1;
			const safeIndex = clamp(Number(pageIndex) || 0, 0, totalPages - 1);
			panel.dataset.pageIndex = String(safeIndex);

			const pageSize = categoryPageSize(panel);
			const start = safeIndex * pageSize;
			const end = start + pageSize;
			rows.forEach((row, idx) => {
				row.toggleAttribute('hidden', !(idx >= start && idx < end));
			});

			const status = panel.querySelector('[data-category-page-status]');
			if (status) status.textContent = `${safeIndex + 1} / ${totalPages}`;

			const prev = panel.querySelector('[data-category-page="prev"]');
			const next = panel.querySelector('[data-category-page="next"]');
			if (prev instanceof HTMLButtonElement) prev.disabled = safeIndex <= 0;
			if (next instanceof HTMLButtonElement) next.disabled = safeIndex >= totalPages - 1;
		}

		// Ajusta automáticamente el tamaño de página (hasta 8) para que NO
		// aparezca scroll vertical dentro de la categoría (mejor UX y evita
		// que el wheel llegue al límite y retroceda al menú).
		function autoFitCategoryPageSize(panel) {
			if (!(panel instanceof HTMLElement)) return;
			initCategoryPagination(panel);

			const rows = Array.from(panel.querySelectorAll('.project-row'));
			const maxPage = getCategoryMaxPageSize();
			const max = Math.min(maxPage, rows.length || maxPage);

			// Probamos desde el máximo hacia abajo hasta que el panel deje de desbordarse.
			let best = max;
			for (let size = max; size >= 1; size--) {
				panel.dataset.pageSize = String(size);
				panel.dataset.pageCount = String(Math.max(1, Math.ceil(rows.length / size)));
				setCategoryPage(panel, 0);

				// Tolerancia por subpíxeles / fonts.
				if (panel.scrollHeight <= panel.clientHeight + 2) {
					best = size;
					break;
				}
			}

			panel.dataset.pageSize = String(best);
			panel.dataset.pageCount = String(Math.max(1, Math.ceil(rows.length / best)));

			const pager = panel.querySelector('[data-category-pagination]');
			if (pager instanceof HTMLElement) {
				if (Number(panel.dataset.pageCount || '1') <= 1) pager.setAttribute('hidden', '');
				else pager.removeAttribute('hidden');
			}

			setCategoryPage(panel, 0);
		}

		function activeCategoryPanel() {
			return root.querySelector('[data-category]:not([hidden])');
		}

		function bindGalleryLoader(panel) {
			if (!(panel instanceof HTMLElement) || panel.dataset.galleryBound === '1') return;
			if (panel.hasAttribute('hidden')) return;
			panel.dataset.galleryBound = '1';

			const gallery = panel.querySelector('.project-image__gallery');
			const images = galleryImages(panel);
			if (!gallery || images.length === 0) return;
			const slug = panel.getAttribute('data-project-image') || '';

			const prefetchFromScroll = () => {
				const index = galleryIndexFromScroll(gallery);
				void ensurePairs(images, index);
				maybePrefetchNext(slug, images, index);
			};

			let scrollTick = 0;
			gallery.addEventListener('scroll', () => {
				if (scrollTick) return;
				scrollTick = window.requestAnimationFrame(() => {
					scrollTick = 0;
					prefetchFromScroll();
				});
			}, { passive: true });

			const figures = Array.from(gallery.querySelectorAll('.project-image__figure'));
			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							const index = figures.indexOf(entry.target);
							if (index < 0) return;
							void ensurePairs(images, index);
							maybePrefetchNext(slug, images, index);
						});
					},
					{
						root: gallery,
						rootMargin: '0px 220% 0px 220%',
						threshold: 0.01,
					}
				);
				figures.forEach((figure) => observer.observe(figure));
			}

			prefetchFromScroll();
		}

		function prepareProjectImage(panel, startIndex = 0) {
			if (!(panel instanceof HTMLElement)) return Promise.resolve();
			const images = galleryImages(panel);
			if (images.length === 0) return Promise.resolve();
			const index = Math.min(Math.max(0, startIndex), images.length - 1);
			
			// Marcamos la primera imagen como prioritaria
			images[index]?.setAttribute('fetchpriority', 'high');
			
			const slug = panel.getAttribute('data-project-image') || '';
			maybePrefetchNext(slug, images, index);
			
			// OPTIMIZADO: Solo esperamos la primera imagen para reducir el tiempo de bloqueo
			// Las siguientes imágenes del par se cargarán en paralelo sin bloquear
			const firstImage = images[index];
			if (firstImage) {
				const firstImagePromise = hydrateImage(firstImage);
				
				// Iniciamos la carga del resto del par en paralelo (sin esperar)
				const start = pairStart(index);
				for (let i = start; i < start + PAIR && i < images.length; i++) {
					if (i !== index) {
						void hydrateImage(images[i]);
					}
				}
				
				// Solo retornamos la promesa de la primera imagen
				return firstImagePromise;
			}
			
			return Promise.resolve();
		}

		function setLayerState(layer, open) {
			if (!layer) return;
			if (open) {
				layer.removeAttribute('aria-hidden');
				layer.removeAttribute('inert');
			} else {
				layer.setAttribute('aria-hidden', 'true');
				layer.setAttribute('inert', '');
			}
		}

		function setDepth(depth, { syncHash = true } = {}) {
			root.dataset.depth = String(depth);
			setLayerState(layerCategory, depth >= 1);
			setLayerState(layerProject, depth >= 2);
			setLayerState(layerImages, depth >= 3);
			setLayerState(layerNext, depth >= 4);

			/* Evita que el scroll horizontal padre robe el pan vertical en móvil */
			const shell = document.querySelector('.horizontal-scroll-container');
			shell?.classList.toggle('is-v-nested', depth > 0);
			document.documentElement.classList.toggle('work-deep', depth > 0);

			if (syncHash) {
				const activeCategory = root.querySelector('[data-category]:not([hidden])');
				const activeProject = root.querySelector('[data-project]:not([hidden])');
				let newUrl = '/#work';
				if (depth >= 2 && activeProject) {
					const projectSlug = activeProject.getAttribute('data-project');
					const row = root.querySelector(`[data-open-project="${projectSlug}"]`);
					const category = row ? row.getAttribute('data-from-category') : null;
					newUrl = category ? `/${category}/${projectSlug}` : `/${projectSlug}`;
				} else if (depth === 1 && activeCategory) {
					newUrl = `/${activeCategory.getAttribute('data-category')}`;
				}
				if (window.location.pathname + window.location.search + window.location.hash !== newUrl) {
					history.pushState(null, '', newUrl);
				}
			}
		}

		function showOnly(nodes, attr, value) {
			nodes.forEach((el) => {
				const match = value !== null && el.getAttribute(attr) === value;
				if (match) el.removeAttribute('hidden');
				else el.setAttribute('hidden', '');
			});
		}

		function hideAllImages() {
			window.clearTimeout(imageTransitionTimer);
			imageTransitionTimer = 0;
			currentImagePanel = null;
			imagePanels().forEach((el) => {
				el.classList.remove('is-entering-forward', 'is-entering-backward');
				el.style.removeProperty('z-index');
				el.setAttribute('hidden', '');
			});
		}

		function scrollGalleryToIndex(panel, imageIndex) {
			const gallery = panel.querySelector('.project-image__gallery');
			if (!gallery) return;
			if (!imageIndex) {
				gallery.scrollLeft = 0;
				return;
			}
			const figures = gallery.querySelectorAll('.project-image__figure');
			const target = figures[imageIndex];
			gallery.scrollLeft = target ? target.offsetLeft : 0;
		}

		function showProjectImage(slug, { animate = false, resetScroll = true, imageIndex = 0 } = {}) {
			const panel = imagePanelFor(slug);
			if (!panel) return false;
			
			const canAnimate = animate && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!canAnimate) {
				window.clearTimeout(imageTransitionTimer);
				imageTransitionTimer = 0;
				imagePanels().forEach((el) => {
					el.classList.remove('is-entering-forward', 'is-entering-backward');
					el.style.removeProperty('z-index');
					if (el === panel) el.removeAttribute('hidden');
					else el.setAttribute('hidden', '');
				});
				currentImagePanel = panel;
				if (resetScroll) scrollGalleryToIndex(panel, imageIndex);
				requestAnimationFrame(() => bindGalleryLoader(panel));
				return true;
			}

			imagePanels().forEach((el) => {
				if (el !== currentImagePanel && el !== panel) {
					el.classList.remove('is-entering-forward', 'is-entering-backward');
					el.style.removeProperty('z-index');
					el.setAttribute('hidden', '');
				}
			});
			
			if (currentImagePanel && currentImagePanel !== panel) {
				currentImagePanel.classList.remove('is-entering-forward', 'is-entering-backward');
				currentImagePanel.style.zIndex = '0';
			}
			
			panel.removeAttribute('hidden');
			panel.classList.remove('is-entering-forward', 'is-entering-backward');
			panel.style.zIndex = '1';
			void panel.offsetWidth;
			panel.classList.add('is-entering-forward');
			currentImagePanel = panel;
			
			if (resetScroll) scrollGalleryToIndex(panel, imageIndex);
			requestAnimationFrame(() => bindGalleryLoader(panel));

			const settle = () => {
				if (currentImagePanel !== panel) return;
				window.clearTimeout(imageTransitionTimer);
				imageTransitionTimer = 0;
				
				imagePanels().forEach((el) => {
					if (el !== panel) {
						el.classList.remove('is-entering-forward', 'is-entering-backward');
						el.style.removeProperty('z-index');
						el.setAttribute('hidden', '');
					}
				});
				panel.classList.remove('is-entering-forward', 'is-entering-backward');
				panel.style.removeProperty('z-index');
			};
			panel.addEventListener('animationend', settle, { once: true });
			window.clearTimeout(imageTransitionTimer);
			imageTransitionTimer = window.setTimeout(settle, 1000);
			return true;
		}



		function openCategory(id, opts) {
			imageOpenRequest += 1;
			const exists = categoryPanels().some((el) => el.getAttribute('data-category') === id);
			if (!exists) return;
			showOnly(categoryPanels(), 'data-category', id);
			showOnly(projectPanels(), 'data-project', null);
			hideAllImages();
			showOnly(nextPanels(), 'data-project-next', null);
			setDepth(1, opts);
			const panel = activeCategoryPanel();
			if (panel instanceof HTMLElement) {
				panel.scrollTop = 0;
				// Esperamos 1 frame para asegurar mediciones correctas.
				requestAnimationFrame(() => autoFitCategoryPageSize(panel));
			}
		}

		function openProject(slug, opts) {
			imageOpenRequest += 1;
			const panel = projectPanels().find((el) => el.getAttribute('data-project') === slug);
			if (!panel) return;

			const row = root.querySelector(`[data-open-project="${slug}"]`);
			const category = row?.getAttribute('data-from-category');
			if (category) {
				showOnly(categoryPanels(), 'data-category', category);
			}

			showOnly(projectPanels(), 'data-project', slug);

			if (currentDepth() >= 3) {
				layerProject.style.transition = 'none';
				layerProject.style.transform = 'translate3d(100%, 0, 0)';
				layerProject.style.zIndex = '6';

				void layerProject.offsetWidth;

				layerProject.style.transition = 'transform var(--dur-panel) var(--ease-out)';
				layerProject.style.transform = 'translate3d(0, 0, 0)';

				afterSlide(layerProject, () => {
					layerProject.style.transition = '';
					layerProject.style.transform = '';
					layerProject.style.zIndex = '';

					hideAllImages();
					showOnly(nextPanels(), 'data-project-next', null);
					setDepth(2, opts);
					const imagePanel = imagePanelFor(slug);
					if (imagePanel) void prepareProjectImage(imagePanel, 0);
				});
				return;
			}

			hideAllImages();
			showOnly(nextPanels(), 'data-project-next', null);
			setDepth(2, opts);
			const imagePanel = imagePanelFor(slug);
			if (imagePanel) void prepareProjectImage(imagePanel, 0);
		}

		function imageOpenOptions(opts) {
			if (typeof opts === 'number') return { imageIndex: opts };
			return opts && typeof opts === 'object' ? opts : {};
		}

		async function openProjectImage(slug, opts) {
			const imagePanel = imagePanelFor(slug);
			if (!imagePanel) return;
			const { imageIndex = 0, ...depthOpts } = imageOpenOptions(opts);
			const requestId = ++imageOpenRequest;
			
			// FIXED: No esperamos la carga de imágenes para abrir la galería
			// Iniciamos la carga en paralelo pero no bloqueamos la UI
			const loadingPromise = prepareProjectImage(imagePanel, imageIndex);

			const projectPanel = projectPanels().find((el) => el.getAttribute('data-project') === slug);
			if (!projectPanel) return;
			if (!showProjectImage(slug, { animate: true, imageIndex })) return;

			const row = root.querySelector(`[data-open-project="${slug}"]`);
			const category = row?.getAttribute('data-from-category');
			if (category) {
				showOnly(categoryPanels(), 'data-category', category);
			}

			showOnly(projectPanels(), 'data-project', slug);
			showOnly(nextPanels(), 'data-project-next', null);
			setDepth(3, depthOpts);
			
			// Las imágenes se cargarán en background sin bloquear la interacción
			void loadingPromise.then(() => {
				// Verificamos que no se haya cambiado de contexto
				if (requestId === imageOpenRequest) {
					// Las imágenes están listas, se marcarán automáticamente como ready
				}
			});
		}

		async function openProjectNext(slug, opts) {
			const requestId = ++imageOpenRequest;
			const panel = nextPanels().find((el) => el.getAttribute('data-project-next') === slug);
			if (!panel) return;

			const projectPanel = projectPanels().find((el) => el.getAttribute('data-project') === slug);
			if (projectPanel) {
				showOnly(projectPanels(), 'data-project', slug);
			}

			await ensureNextPreviews(slug);
			if (requestId !== imageOpenRequest) return;

			const imagePanel = imagePanelFor(slug);
			if (imagePanel) {
				showProjectImage(slug, { animate: false, resetScroll: false });
			}

			showOnly(nextPanels(), 'data-project-next', slug);
			setDepth(4, opts);
		}

		function afterSlide(layer, done) {
			let finished = false;
			const finish = () => {
				if (finished) return;
				finished = true;
				layer?.removeEventListener('transitionend', onEnd);
				clearTimeout(timer);
				done();
			};
			const onEnd = (event) => {
				if (event.target === layer && event.propertyName === 'transform') finish();
			};
			layer?.addEventListener('transitionend', onEnd);
			const timer = setTimeout(finish, 1000);
			if (!layer) finish();
		}

		function currentDepth() {
			return Number(root.dataset.depth || 0);
		}

		async function goBack() {
			const depth = currentDepth();
			if (depth === 4) {
				setDepth(3);
				afterSlide(layerNext, () => {
					if (currentDepth() < 4) showOnly(nextPanels(), 'data-project-next', null);
				});
			} else if (depth === 3) {
				const project = activeProjectPanel();
				const slug = project?.getAttribute('data-project');
				const panel = imagePanelFor(slug);
				if (panel) {
					const gallery = panel.querySelector('.project-image__gallery');
					if (gallery) {
						const isAtStart = gallery.scrollLeft <= 10;
						if (!isAtStart) {
							const images = galleryImages(panel);
							const current = galleryIndexFromScroll(gallery);
							void ensurePairs(images, Math.max(0, current - 1));
							gallery.scrollBy({ left: -gallery.clientWidth, behavior: 'smooth' });
							return;
						}
					}
				}
				imageOpenRequest += 1;
				setDepth(2);
				afterSlide(layerImages, () => {
					if (currentDepth() < 3) hideAllImages();
				});
			} else if (depth === 2) {
				imageOpenRequest += 1;
				setDepth(1);
				afterSlide(layerProject, () => {
					if (currentDepth() < 2) showOnly(projectPanels(), 'data-project', null);
				});
			} else if (depth === 1) {
				imageOpenRequest += 1;
				setDepth(0);
				afterSlide(layerCategory, () => {
					if (currentDepth() < 1) showOnly(categoryPanels(), 'data-category', null);
				});
			}
		}

		function closeAll(opts) {
			imageOpenRequest += 1;
			setDepth(0, opts);
			afterSlide(layerCategory, () => {
				if (currentDepth() > 0) return;
				showOnly(nextPanels(), 'data-project-next', null);
				hideAllImages();
				showOnly(projectPanels(), 'data-project', null);
				showOnly(categoryPanels(), 'data-category', null);
			});
		}

		function activeProjectPanel() {
			return root.querySelector('[data-project]:not([hidden])');
		}

		function advanceWork() {
			const depth = currentDepth();
			const project = activeProjectPanel();
			const slug = project?.getAttribute('data-project');
			if (!slug) return false;

			if (depth === 2) {
				if (imagePanelFor(slug)) {
					void openProjectImage(slug);
				} else {
					void openProjectNext(slug);
				}
				return true;
			}

			if (depth === 3) {
				const panel = imagePanelFor(slug);
				if (panel) {
					const gallery = panel.querySelector('.project-image__gallery');
					if (gallery) {
						const isAtEnd = gallery.scrollLeft + gallery.clientWidth >= gallery.scrollWidth - 10;
						if (!isAtEnd) {
							const images = galleryImages(panel);
							const current = galleryIndexFromScroll(gallery);
							void ensurePairs(images, current + 1);
							gallery.scrollBy({ left: gallery.clientWidth, behavior: 'smooth' });
							return true;
						}
						void ensureNextPreviews(slug);
					}
				}
				void openProjectNext(slug);
				return true;
			}

			return false;
		}

		let deepWheelAccumulator = 0;
		let deepWheelTimer = 0;
		const DEEP_WHEEL_THRESHOLD = 36;
		const DEEP_WHEEL_IDLE = 180;
		/* Las imágenes y capas del detalle usan --dur-panel: 0.8s. */
		const DEEP_WHEEL_COOLDOWN = 840;
		const WORK_EXIT_WHEEL_GUARD = DEEP_WHEEL_COOLDOWN;
		let deepWheelBlockedUntil = 0;

		function clearDeepWheelAccumulator() {
			window.clearTimeout(deepWheelTimer);
			deepWheelTimer = 0;
			deepWheelAccumulator = 0;
		}

		function keepDeepWheelOpen() {
			window.clearTimeout(deepWheelTimer);
			deepWheelTimer = window.setTimeout(
				clearDeepWheelAccumulator,
				DEEP_WHEEL_IDLE,
			);
		}

		function blockDeepWheel() {
			clearDeepWheelAccumulator();
			deepWheelBlockedUntil = performance.now() + DEEP_WHEEL_COOLDOWN;
		}

		function guardWorkExitWheel() {
			root.dataset.wheelExitGuardUntil = String(performance.now() + WORK_EXIT_WHEEL_GUARD);
		}

		function canScrollVertically(el, deltaY) {
			if (!(el instanceof Element)) return false;
			const style = getComputedStyle(el);
			const overflowY = style.overflowY;
			if (overflowY !== 'auto' && overflowY !== 'scroll' && overflowY !== 'overlay') {
				return false;
			}
			const max = el.scrollHeight - el.clientHeight;
			if (max <= 1) return false;
			if (deltaY < 0) return el.scrollTop > 0;
			if (deltaY > 0) return el.scrollTop < max - 1;
			return true;
		}

		function canScrollHorizontally(el, deltaX) {
			if (!(el instanceof Element)) return false;
			const style = getComputedStyle(el);
			const overflowX = style.overflowX;
			if (overflowX !== 'auto' && overflowX !== 'scroll' && overflowX !== 'overlay') {
				return false;
			}
			const max = el.scrollWidth - el.clientWidth;
			if (max <= 1) return false;
			if (deltaX < 0) return el.scrollLeft > 0;
			if (deltaX > 0) return el.scrollLeft < max - 1;
			return true;
		}

		/* El wheel vertical navega horizontalmente también dentro del detalle. */
		root.addEventListener('wheel', (event) => {
			const depth = currentDepth();
			if (depth < 1) return;

			const horizontalIntent = Math.abs(event.deltaX) > Math.abs(event.deltaY);
			const rawDelta = horizontalIntent ? event.deltaX : event.deltaY;
			const deltaScale =
				event.deltaMode === WheelEvent.DOM_DELTA_LINE
					? 16
					: event.deltaMode === WheelEvent.DOM_DELTA_PAGE
						? root.clientWidth
						: 1;
			const delta = rawDelta * deltaScale;
			if (Math.abs(delta) < 2) return;

			/* En las tablas de categoría, solo se vuelve al menú al llegar arriba. */
			if (depth === 1) {
				const categoryScroll = root.querySelector('[data-category]:not([hidden])');
				if (
					!horizontalIntent &&
					canScrollVertically(categoryScroll, delta)
				) {
					return;
				}
				if (delta >= 0) return;

				event.preventDefault();
				event.stopPropagation();
				if (performance.now() < deepWheelBlockedUntil) return;
				/* La inercia restante no debe hacer retroceder el carrusel padre. */
				blockDeepWheel();
				guardWorkExitWheel();
				void goBack();
				return;
			}
			
			/* Carrusel de imágenes (Capa 3) */
			if (depth === 3) {
				const project = activeProjectPanel();
				const slug = project?.getAttribute('data-project');
				const panel = imagePanelFor(slug);
				const gallery = panel?.querySelector('.project-image__gallery');
				if (gallery) {
					/* Scroll horizontal nativo (trackpad/rueda horizontal): dejar pasar */
					if (horizontalIntent) {
						if (canScrollHorizontally(gallery, rawDelta)) return;
					} else {
						/* Scroll vertical → convertir en avance/retroceso de imagen completa */
						event.preventDefault();
						event.stopPropagation();
						if (performance.now() < deepWheelBlockedUntil) return;

						if (deepWheelAccumulator && Math.sign(deepWheelAccumulator) !== Math.sign(delta)) {
							deepWheelAccumulator = 0;
						}
						deepWheelAccumulator += delta;
						keepDeepWheelOpen();
						if (Math.abs(deepWheelAccumulator) < DEEP_WHEEL_THRESHOLD) return;

						const direction = Math.sign(deepWheelAccumulator);
						clearDeepWheelAccumulator();
						blockDeepWheel();

						if (direction > 0) {
							/* Avanzar: si quedan imágenes, ir a la siguiente */
							const isAtEnd = gallery.scrollLeft + gallery.clientWidth >= gallery.scrollWidth - 10;
							if (!isAtEnd) {
								const images = galleryImages(panel);
								const current = galleryIndexFromScroll(gallery);
								void ensurePairs(images, current + 1);
								gallery.scrollBy({ left: gallery.clientWidth, behavior: 'smooth' });
							} else {
								void ensureNextPreviews(slug);
								guardWorkExitWheel();
								void openProjectNext(slug);
							}
						} else {
							/* Retroceder: si hay imágenes anteriores, ir a la anterior */
							const isAtStart = gallery.scrollLeft <= 10;
							if (!isAtStart) {
								const images = galleryImages(panel);
								const current = galleryIndexFromScroll(gallery);
								void ensurePairs(images, Math.max(0, current - 1));
								gallery.scrollBy({ left: -gallery.clientWidth, behavior: 'smooth' });
							} else {
								guardWorkExitWheel();
								void goBack();
							}
						}
						return;
					}
				}
			}

			/* La pantalla final no tiene un destino automático hacia delante. */
			if (depth === 4 && delta > 0) return;

			event.preventDefault();
			event.stopPropagation();

			/* No queda un booleano de gesto retenido. La transición visible es
			   quien define el periodo de protección contra su propia inercia. */
			if (performance.now() < deepWheelBlockedUntil) return;
			if (deepWheelAccumulator && Math.sign(deepWheelAccumulator) !== Math.sign(delta)) {
				deepWheelAccumulator = 0;
			}
			deepWheelAccumulator += delta;
			keepDeepWheelOpen();
			if (Math.abs(deepWheelAccumulator) < DEEP_WHEEL_THRESHOLD) return;

			const direction = Math.sign(deepWheelAccumulator);
			clearDeepWheelAccumulator();
			blockDeepWheel();
			if (direction > 0) {
				if (!advanceWork()) deepWheelBlockedUntil = 0;
			} else {
				void goBack();
			}
		}, { passive: false });

		root.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;

			const pagerControl = target.closest('[data-category-page]');
			if (pagerControl instanceof HTMLElement) {
				const panel = pagerControl.closest('[data-category]');
				if (panel instanceof HTMLElement) {
					event.preventDefault();
					const direction = pagerControl.getAttribute('data-category-page');
					const current = Number(panel.dataset.pageIndex || 0);
					if (direction === 'prev') setCategoryPage(panel, current - 1);
					if (direction === 'next') setCategoryPage(panel, current + 1);
				}
				return;
			}

			if (target.closest('[data-work-forward]')) {
				event.preventDefault();
				advanceWork();
				return;
			}

			const externalControl = target.closest('[data-external-url]');
			if (externalControl instanceof HTMLElement) {
				const url = externalControl.getAttribute('data-external-url');
				if (!url) return;
				event.preventDefault();
				event.stopPropagation();
				window.open(url, '_blank', 'noopener,noreferrer');
				return;
			}

			const openCategoryBtn = target.closest('[data-open-category]');
			if (openCategoryBtn instanceof HTMLElement) {
				event.preventDefault();
				openCategory(openCategoryBtn.getAttribute('data-open-category') || '');
				return;
			}

			const openImageBtn = target.closest('[data-open-project-image]');
			if (openImageBtn instanceof HTMLElement) {
				event.preventDefault();
				const slug = openImageBtn.getAttribute('data-open-project-image') || '';
				const index = Number(openImageBtn.getAttribute('data-image-index') || 0);
				openProjectImage(slug, index);
				return;
			}

			const openNextBtn = target.closest('[data-open-project-next]');
			if (openNextBtn instanceof HTMLElement) {
				event.preventDefault();
				openProjectNext(openNextBtn.getAttribute('data-open-project-next') || '');
				return;
			}

			if (target.closest('[data-nav-back]')) {
				event.preventDefault();
				goBack();
				return;
			}

			const openProjectBtn = target.closest('[data-open-project]');
			if (openProjectBtn instanceof HTMLElement) {
				event.preventDefault();
				openProject(openProjectBtn.getAttribute('data-open-project') || '');
				return;
			}
		});

		root.addEventListener('work:back', () => goBack());
		root.addEventListener('work:forward', () => advanceWork());
		root.addEventListener('work:close', () => closeAll());

		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const link = target.closest('a[href^="#"]');
			if (!(link instanceof HTMLAnchorElement)) return;
			const hash = link.getAttribute('href');
			if (!hash || hash === '#work') {
				if (hash === '#work' && Number(root.dataset.depth || 0) > 0) {
					closeAll();
				}
				return;
			}
			if (hash === '#about' || hash === '#contact' || hash === '#ikeneas') {
				if (Number(root.dataset.depth || 0) > 0) closeAll();
			}
		});

		function ensureWorkVisible() {
			const container = document.querySelector('.horizontal-scroll-container');
			if (container instanceof HTMLElement) {
				if (window.matchMedia('(max-width: 700px)').matches) {
					container.scrollTo({ top: root.offsetTop, behavior: 'instant' });
				} else {
					container.scrollTo({ left: root.offsetLeft, behavior: 'instant' });
				}
			}
		}

		let isInitialLoad = true;
		function routeTarget() {
			const hashId = location.hash.replace(/^#/, '');
			if (hashId) return { id: hashId, source: 'hash', fullPath: hashId };

			const queryId = new URLSearchParams(location.search).get('route');
			if (queryId) {
				const decoded = decodeURIComponent(queryId);
				const parts = decoded.split('/');
				return { id: parts[parts.length - 1], source: 'query', fullPath: decoded };
			}

			const pathId = location.pathname.replace(/^\/+|\/+$/g, '');
			if (pathId) {
				const decoded = decodeURIComponent(pathId);
				const parts = decoded.split('/');
				return { id: parts[parts.length - 1], source: 'path', fullPath: decoded };
			}

			return { id: '', source: 'none', fullPath: '' };
		}

		function applyHash() {
			if (isInitialLoad) {
				root.classList.add('no-transition');
			}

			const { id, source, fullPath } = routeTarget();
			if (!id || id === 'work') {
				if (id === 'work') ensureWorkVisible();
				closeAll({ syncHash: false });
			} else if (categoryPanels().some((el) => el.getAttribute('data-category') === id)) {
				ensureWorkVisible();
				openCategory(id, { syncHash: false });
			} else if (projectPanels().some((el) => el.getAttribute('data-project') === id)) {
				ensureWorkVisible();
				openProject(id, { syncHash: false });
			}

			if (source === 'query') {
				const cleanUrl = fullPath && fullPath !== 'work' ? `/${fullPath.split('/').map(encodeURIComponent).join('/')}` : '/';
				if (window.location.pathname + window.location.search + window.location.hash !== cleanUrl) {
					history.replaceState(null, '', cleanUrl);
				}
			}

			if (isInitialLoad) {
				// Forzamos el reflow para que el cambio de clase sin transición se aplique de inmediato
				void root.offsetHeight;
				setTimeout(() => {
					root.classList.remove('no-transition');
				}, 50);
				isInitialLoad = false;
			}
		}

		// Si la ventana cambia de tamaño, re-ajustamos el tamaño de página en
		// la categoría activa para evitar scroll vertical inesperado.
		window.addEventListener('resize', () => {
			const panel = activeCategoryPanel();
			if (panel instanceof HTMLElement && currentDepth() === 1) {
				requestAnimationFrame(() => autoFitCategoryPageSize(panel));
			}
		});

		root.addEventListener('pointerenter', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const row = target.closest('[data-open-project]');
			if (!(row instanceof HTMLElement)) return;
			const slug = row.getAttribute('data-open-project') || '';
			const panel = imagePanelFor(slug);
			if (!panel) return;
			// Precargamos SOLO la primera imagen en hover para evitar bloqueos
			const images = galleryImages(panel);
			if (images.length > 0) {
				images[0]?.setAttribute('fetchpriority', 'high');
				void hydrateImage(images[0]);
				// Iniciamos la segunda imagen en background
				if (images.length > 1) {
					setTimeout(() => void hydrateImage(images[1]), 100);
				}
			}
		}, true);

		applyHash();
		window.addEventListener('hashchange', applyHash);
		window.addEventListener('popstate', applyHash);

		window.__workGoBack = goBack;
		window.__workDepth = () => Number(root.dataset.depth || 0);
	}
</script>

<style>
	.work-slide {
		flex: 0 0 100vw;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		scroll-snap-align: start;
		position: relative;
		overflow: hidden;
		background-color: #eeedec;
	}

	.work-layer {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.work-layer--menu {
		z-index: 1;
	}

	.work-layer--category,
	.work-layer--project,
	.work-layer--images,
	.work-layer--next {
		z-index: 2;
		transform: translate3d(100%, 0, 0);
		transition: transform var(--dur-panel) var(--ease-out);
		pointer-events: none;
		overflow: hidden;
