---
import Logo from './Logo.astro';
import ikeneasData from '../content/ikeneas.json';

export type NavSection = 'about' | 'work' | 'ikeneas' | 'contact';

interface Props {
	theme?: 'light' | 'dark';
	/** Sección a la que pertenece el slide que contiene este navbar */
	active?: NavSection;
	/** Mostrar logo a la izquierda sin alterar la posición de los nav items */
	showLogo?: boolean;
}

const { theme = 'light', active, showLogo = false } = Astro.props;

const links: { id: NavSection; label: string; externalUrl?: string }[] = [
	{ id: 'about', label: 'About' },
	{ id: 'work', label: 'Work' },
	// Los sitios existentes no tienen este campo; el enlace se conserva visible.
	...(ikeneasData.show_in_navigation !== false
		? [{ id: 'ikeneas' as const, label: ikeneasData.name, externalUrl: ikeneasData.url }]
		: []),
	{ id: 'contact', label: 'Contact' },
];
---

<nav class={`navbar ${theme}${showLogo ? ' has-logo' : ''}`}>
	{showLogo && <Logo class="navbar-logo" />}
	<button
		type="button"
		class="navbar__toggle"
		aria-label="Abrir menú de navegación"
		aria-expanded="false"
		data-cursor-nav
	>
		<span></span>
		<span></span>
		<span></span>
	</button>
	<div class="navbar__overlay"></div>
	<ul>
		{links.map((link) => (
			<li>
				<a
					href={`#${link.id}`}
					data-external-url={link.externalUrl}
					data-label={link.label}
					aria-current={active === link.id ? 'page' : undefined}
				>
					<span class="navbar-link__label">{link.label}</span>
				</a>
			</li>
		))}
	</ul>
</nav>

<script>
	// Astro hoists this script, runs once for every rendered Navbar.
	const syncHeroMenuLayer = (navbar: Element, isOpen: boolean) => {
		/* El panel mobile es fixed, pero necesita que el header de portada
		   gane la pila frente al texto del hero mientras está abierto. */
		navbar.closest('.hero-header')?.classList.toggle('is-menu-open', isOpen);
	};

	const closeNavbar = (navbar: Element) => {
		navbar.classList.remove('is-open');
		syncHeroMenuLayer(navbar, false);
		const toggle = navbar.querySelector('.navbar__toggle');
		if (toggle) {
			toggle.setAttribute('aria-expanded', 'false');
			toggle.setAttribute('aria-label', 'Abrir menú de navegación');
		}
	};

	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		/* Clic en el overlay → cerrar */
		const overlay = target.closest('.navbar__overlay');
		if (overlay) {
			const navbar = overlay.closest('.navbar');
			if (navbar) closeNavbar(navbar);
			return;
		}

		const toggle = target.closest('.navbar__toggle');
		if (toggle instanceof HTMLButtonElement) {
			const navbar = toggle.closest('.navbar');
			if (!navbar) return;
			const willOpen = !navbar.classList.contains('is-open');
			document.querySelectorAll('.navbar.is-open').forEach(closeNavbar);
			if (willOpen) {
				navbar.classList.add('is-open');
				syncHeroMenuLayer(navbar, true);
				toggle.setAttribute('aria-expanded', 'true');
				toggle.setAttribute('aria-label', 'Cerrar menú de navegación');
			}
			return;
		}

		const link = target.closest('.navbar a');
		if (link instanceof HTMLElement) {
			const navbar = link.closest('.navbar');
			if (navbar) closeNavbar(navbar);
			// Si es un link externo, abrirlo y prevenir la navegación por hash
			const externalUrl = link.getAttribute('data-external-url');
			if (externalUrl) {
				event.preventDefault();
				window.open(externalUrl, '_blank', 'noopener,noreferrer');
			}
			return;
		}

		document.querySelectorAll('.navbar.is-open').forEach((navbar) => {
			if (!navbar.contains(target)) closeNavbar(navbar);
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			document.querySelectorAll('.navbar.is-open').forEach(closeNavbar);
		}
	});
</script>

<style>
	.navbar {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		width: 100%;
		position: relative;
	}

	.navbar :global(.navbar-logo) {
		position: absolute;
		left: 0;
		top: 0;
		pointer-events: auto;
	}

	.navbar ul {
		display: flex;
		gap: calc(var(--nav-gap) * 1.4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.navbar__toggle {
		display: none;
	}

	.navbar__overlay {
		display: none;
	}

	.navbar a {
		position: relative;
		display: inline-block;
		overflow: hidden;
		padding-bottom: 0.1em;
		font-family: var(--font-nav);
		font-weight: 600;
		font-size: var(--nav-size);
		letter-spacing: 0.03em;
		text-transform: capitalize;
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	.navbar a::before {
		content: attr(data-label);
		position: absolute;
		left: 0;
		top: 100%;
		transition: transform var(--dur-fast) var(--ease-out);
	}

	.navbar-link__label {
		display: block;
		transition: transform var(--dur-fast) var(--ease-out);
	}

	.navbar a:hover,
	.navbar a:focus-visible {
		opacity: 0.75;
	}

	.navbar a:hover .navbar-link__label,
	.navbar a:focus-visible .navbar-link__label {
		transform: translateY(-112%);
	}

	.navbar a:hover::before,
	.navbar a:focus-visible::before {
		transform: translateY(-112%);
	}

	/* Subrayado animado de la sección actual */
	.navbar a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: max(2px, 0.09em);
		background-color: currentColor;
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform var(--dur-med) var(--ease-out);
	}

	.navbar a[aria-current='page']::after {
		transform: scaleX(1);
	}

	.light a {
		color: #ffffff;
	}

	.dark a {
		color: #000000;
	}

	@media (max-width: 700px) {
		.navbar {
			width: auto;
			min-width: 2.75rem;
			justify-content: flex-end;
			z-index: 9990;
		}

		.navbar__toggle {
			position: relative;
			z-index: 9992;
			display: grid;
			place-content: center;
			gap: 0.28rem;
			width: 2.75rem;
			height: 2.75rem;
			padding: 0;
			border: none;
			background: transparent;
			color: currentColor;
			cursor: pointer;
		}

		.navbar__toggle span {
			display: block;
			width: 1.5rem;
			height: 2px;
			background: currentColor;
			transform-origin: center;
			transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
		}

		.navbar.is-open .navbar__toggle span:nth-child(1) {
			transform: translateY(0.56rem) rotate(45deg);
		}

		.navbar.is-open .navbar__toggle span:nth-child(2) {
			opacity: 0;
		}

		.navbar.is-open .navbar__toggle span:nth-child(3) {
			transform: translateY(-0.56rem) rotate(-45deg);
		}

		/* ── Overlay de fondo ── */
		.navbar__overlay {
			position: fixed;
			inset: 0;
			z-index: 9989;
			background: rgba(0, 0, 0, 0.4);
			opacity: 0;
			pointer-events: none;
			transition: opacity var(--dur-fast) var(--ease-out);
			-webkit-backdrop-filter: blur(2px);
			backdrop-filter: blur(2px);
		}

		.navbar.is-open .navbar__overlay {
			opacity: 1;
			pointer-events: auto;
		}

		/* ── Panel del menú (fixed, no lo recorta overflow:hidden) ── */
		.navbar ul {
			position: fixed;
			top: 0;
			right: 0;
			z-index: 9991;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: center;
			gap: 1.6rem;
			width: min(75vw, 20rem);
			height: 100%;
			height: 100dvh;
			margin: 0;
			padding: 3rem 2rem 3rem 2.2rem;
			box-sizing: border-box;
			transform: translate3d(100%, 0, 0);
			pointer-events: none;
			transition: transform 0.38s var(--ease-out);
		}

		.navbar.is-open ul {
			transform: translate3d(0, 0, 0);
			pointer-events: auto;
		}

		.navbar li {
			opacity: 0;
			transform: translate3d(1.5rem, 0, 0);
			transition:
				opacity 0.25s var(--ease-out),
				transform 0.35s var(--ease-out);
		}

		.navbar.is-open li {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}

		.navbar.is-open li:nth-child(1) { transition-delay: 0.08s; }
		.navbar.is-open li:nth-child(2) { transition-delay: 0.14s; }
		.navbar.is-open li:nth-child(3) { transition-delay: 0.20s; }
		.navbar.is-open li:nth-child(4) { transition-delay: 0.26s; }

		.navbar a {
			font-size: clamp(1.15rem, 5.5vw, 1.5rem);
			overflow: visible;
		}

		/* Deshabilitar el efecto hover de slide en móvil */
		.navbar a::before {
			display: none;
		}

		.navbar a:hover .navbar-link__label,
		.navbar a:focus-visible .navbar-link__label {
			transform: none;
		}

		/* ── Colores del panel por tema ── */
		.light .navbar__toggle {
			color: #ffffff;
		}

		.light ul {
			background: #050505;
			color: #ffffff;
		}

		.light a {
			color: #ffffff;
		}

		.dark .navbar__toggle {
			color: #000000;
		}

		.dark ul {
			background: #eeedec;
			color: #000000;
		}

		.dark a {
			color: #000000;
		}

		/* Cuando el menú está abierto, el toggle hereda color del panel */
		.light.is-open .navbar__toggle {
			color: #ffffff;
		}

		.dark.is-open .navbar__toggle {
			color: #000000;
		}
	}
</style>
