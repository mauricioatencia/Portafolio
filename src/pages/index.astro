---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import AboutSection from '../components/AboutSection.astro';
import WorkSlide from '../components/WorkSlide.astro';
import ContactSection from '../components/ContactSection.astro';
import homeData from '../content/home.json';
import {
	getMediaDeliveryUrl,
	getMobileHeroPosterUrl,
	getMobileHeroVideoUrl,
	getVideoPosterUrl,
	isVideoMedia,
} from '../utils/media';

const heroMediaSource = homeData.hero_media || (homeData as any).hero_image || '';
const heroMedia = getMediaDeliveryUrl(heroMediaSource);
const isVideo = isVideoMedia(heroMediaSource);
const heroPoster = getVideoPosterUrl(heroMediaSource) || '/hero-poster.jpg';
// Conserva el corte móvil actual solo mientras el hero legacy siga activo.
// Para los videos nuevos Cloudinary deriva un corte vertical liviano desde el
// mismo original: no hay un segundo archivo que el editor tenga que subir.
const mobileHeroMediaSource =
	(homeData as { hero_media_mobile?: string }).hero_media_mobile ||
	(heroMediaSource === '/mam-web.mp4' ? '/mam-web-mobile.mp4' : '');
const mobileHeroMedia = mobileHeroMediaSource
	? getMediaDeliveryUrl(mobileHeroMediaSource)
	: getMobileHeroVideoUrl(heroMediaSource);
const mobileHeroPoster = getMobileHeroPosterUrl(heroMediaSource) || heroPoster;
---

<Layout>
	<main class="horizontal-scroll-container">
		<section class="slide hero-slide" style={`--bg-color: ${homeData.background_color}; --overlay-opacity: ${homeData.overlay_opacity}; --overlay-opacity-active: ${homeData.overlay_opacity_active};`}>
			<div class="hero-media" aria-hidden="true">
				{isVideo ? (
					<video
						class="hero-video"
						autoplay
						muted
						loop
						playsinline
						webkit-playsinline
						preload="none"
						data-src-desktop={heroMedia}
						data-src-mobile={mobileHeroMedia || undefined}
						data-poster-desktop={heroPoster}
						data-poster-mobile={mobileHeroPoster || undefined}
						disablePictureInPicture
					></video>
				) : (
					heroMedia && (
						<img
							class="hero-image"
							src={heroMedia}
							alt=""
							fetchpriority="high"
							decoding="async"
						/>
					)
				)}
			</div>
			<div class="overlay"></div>
			<header class="slide-header hero-header reveal" style="--reveal-delay: 80ms">
				<Navbar theme="light" />
			</header>
			
			<div class="hero-content">
			</div>


			<button
				type="button"
				class="scroll-hint reveal"
				style="--reveal-delay: 420ms"
				aria-label="Ir a la siguiente sección"
				data-next-slide
				data-cursor-nav
			>
				<div class="scroll-hint__arrow">
					<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M5 12h14M12 5l7 7-7 7"/>
					</svg>
				</div>
			</button>
		</section>

		<AboutSection />

		<WorkSlide />

		<ContactSection />
	</main>
</Layout>

<script is:inline>
	// Elige la fuente mobile/desktop ANTES de iniciar cualquier descarga. Así un
	// teléfono no llega a pedir ni siquiera los metadatos del video desktop.
	// En iOS, cada video.load() posterior a un play() exitoso puede tirar
	// abajo la reproducción y sacarla de la ventana en la que Safari permite
	// autoplay sin gesto del usuario, dejando el video pausado hasta un tap.
	(function() {
		function isMobileViewport() {
			return window.matchMedia('(max-width: 700px)').matches;
		}

		function tryPlay(video) {
			const playPromise = video.play();
			if (playPromise !== undefined) {
				playPromise.catch(() => {
					// Bloqueado (gesto requerido, Modo de bajo consumo, etc.):
					// se reintenta una sola vez en la primera interacción, más abajo.
				});
			}
		}

		function prepareVideo(video) {
			const mobile = isMobileViewport();
			const source = (mobile ? video.dataset.srcMobile : video.dataset.srcDesktop)
				|| video.dataset.srcDesktop;
			const poster = (mobile ? video.dataset.posterMobile : video.dataset.posterDesktop)
				|| video.dataset.posterDesktop;

			if (!source) return;
			if (poster) video.poster = poster;

			video.muted = true;
			video.defaultMuted = true;
			video.setAttribute('muted', '');
			video.setAttribute('playsinline', '');
			video.setAttribute('webkit-playsinline', '');

			// src no existe en el HTML para que el navegador no haga una solicitud
			// anticipada al archivo de escritorio antes de conocer el viewport.
			video.src = source;
			video.load();

			const play = () => {
				video.play().catch(() => {
					// Safari puede bloquear autoplay por configuración.
				});
			};

			if (video.readyState >= 2) {
				play();
			} else {
				video.addEventListener('canplay', play, { once: true });
			}
		}

		function init() {
			document.querySelectorAll('.hero-video').forEach((video) => {
				if (video instanceof HTMLVideoElement) prepareVideo(video);
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', init);
		} else {
			init();
		}

		// Único reintento, en la primera interacción, solo para los videos
		// que hayan quedado pausados (Modo de bajo consumo bloquea el
		// autoplay por completo en iOS y solo se levanta con un gesto).
		const retryOnInteraction = () => {
			document.querySelectorAll('.hero-video').forEach((video) => {
				if (video instanceof HTMLVideoElement && video.paused) {
					video.muted = true;
					tryPlay(video);
				}
			});
		};
		['touchstart', 'click', 'scroll'].forEach((evt) => {
			document.addEventListener(evt, retryOnInteraction, { once: true, passive: true });
		});
	})();
</script>

<script>
	// @ts-nocheck
	const container = document.querySelector('.horizontal-scroll-container');
	if (container) {
		/* Astro puede insertar <script> entre componentes: solo las secciones son slides. */
		const slides = () =>
			Array.from(container.querySelectorAll(':scope > section'));

		let currentIndex = 0;
		let isScrolling = false;
		let navigationDirection = 0;
		let navigationTimer = 0;
		let navigationFrame = 0;
		let queuedKeyboardDirection = 0;
		const NAVIGATION_DURATION = 620;
		const NAVIGATION_FALLBACK = NAVIGATION_DURATION + 180;
		const WHEEL_THRESHOLD = 80;
		const HORIZONTAL_WHEEL_IDLE = 180;
		const HORIZONTAL_WHEEL_COOLDOWN = NAVIGATION_DURATION + 40;
		const VERTICAL_WHEEL_IDLE = 180;
		const VERTICAL_WHEEL_COOLDOWN = NAVIGATION_DURATION + 40;
		const TOUCH_INTENT_THRESHOLD = 5;
		const SWIPE_THRESHOLD = 80;
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const mobileLayoutQuery = window.matchMedia('(max-width: 700px)');

		function isVerticalLayout() {
			return mobileLayoutQuery.matches;
		}

		function scrollPosition() {
			return isVerticalLayout() ? container.scrollTop : container.scrollLeft;
		}

		function setScrollPosition(position) {
			if (isVerticalLayout()) container.scrollTop = position;
			else container.scrollLeft = position;
		}

		function slidePosition(slide) {
			return isVerticalLayout() ? slide.offsetTop : slide.offsetLeft;
		}

		function nearestIndex() {
			const position = scrollPosition();
			const list = slides();
			let best = 0;
			let bestDist = Infinity;
			list.forEach((slide, i) => {
				const dist = Math.abs(slidePosition(slide) - position);
				if (dist < bestDist) {
					bestDist = dist;
					best = i;
				}
			});
			return best;
		}

		function setActiveSlide(index) {
			slides().forEach((slide, i) => {
				const on = i === index;
				const wasOn = slide.classList.contains('is-active');
				if (on === wasOn) return;
				slide.classList.toggle('is-active', on);
				if (on) slide.setAttribute('data-active', '');
				else slide.removeAttribute('data-active');
				
				// Reproducir video cuando el slide se activa. Sin video.load():
				// ya se preparó en el script is:inline, y volver a cargarlo acá
				// puede interrumpir una reproducción que ya estaba andando.
				if (on) {
					const video = slide.querySelector('.hero-video');
					if (video instanceof HTMLVideoElement && video.paused) {
						video.muted = true;
						video.play().catch(() => {});
					}
				} else {
					// Pausar video cuando el slide se desactiva
					const video = slide.querySelector('.hero-video');
					if (video instanceof HTMLVideoElement) {
						video.pause();
					}
				}
			});
		}

		function finishNavigation() {
			if (navigationFrame) {
				window.cancelAnimationFrame(navigationFrame);
				navigationFrame = 0;
			}
			window.clearTimeout(navigationTimer);
			navigationTimer = 0;
			container.style.removeProperty('scroll-snap-type');
			isScrolling = false;
			navigationDirection = 0;
			currentIndex = nearestIndex();
			setActiveSlide(currentIndex);
			/* Las teclas son acciones discretas: se conserva solo el siguiente
			   paso, sin confundirlo con la inercia de un touchpad. */
			const nextKeyboardDirection = queuedKeyboardDirection;
			queuedKeyboardDirection = 0;
			if (nextKeyboardDirection) go(nextKeyboardDirection);
		}

		function animateToSlide(targetPosition, smooth) {
			if (navigationFrame) {
				window.cancelAnimationFrame(navigationFrame);
				navigationFrame = 0;
			}

			const start = scrollPosition();
			const distance = targetPosition - start;
			if (!smooth || prefersReducedMotion || Math.abs(distance) <= 2) {
				setScrollPosition(targetPosition);
				return false;
			}

			/* El snap se pausa durante la animaciÃ³n para que no salte entre slides. */
			container.style.scrollSnapType = 'none';
			const startedAt = performance.now();
			const easeInOut = (progress) => -(Math.cos(Math.PI * progress) - 1) / 2;

			const step = (now) => {
				const progress = Math.min(1, (now - startedAt) / NAVIGATION_DURATION);
				setScrollPosition(start + distance * easeInOut(progress));
				if (progress < 1) {
					navigationFrame = window.requestAnimationFrame(step);
					return;
				}
				navigationFrame = 0;
				finishNavigation();
			};

			navigationFrame = window.requestAnimationFrame(step);
			return true;
		}

		function goToIndex(index, { smooth = true } = {}) {
			const list = slides();
			const next = Math.min(list.length - 1, Math.max(0, index));
			const slide = list[next];
			if (!slide) return false;

			const targetPosition = slidePosition(slide);
			const alreadyThere = Math.abs(scrollPosition() - targetPosition) <= 2;
			if (alreadyThere) {
				currentIndex = next;
				setActiveSlide(next);
				return false;
			}

			currentIndex = next;
			isScrolling = true;
			window.clearTimeout(navigationTimer);
			if (animateToSlide(targetPosition, smooth)) {
				navigationTimer = window.setTimeout(finishNavigation, NAVIGATION_FALLBACK);
			} else {
				finishNavigation();
			}
			return true;
		}

		function go(delta) {
			if (isScrolling) {
				/* Only a reversal can interrupt an in-flight transition. */
				if (delta !== -navigationDirection) return;
				const target = Math.min(slides().length - 1, Math.max(0, currentIndex + delta));
				if (goToIndex(target)) {
					navigationDirection = delta;
					const id = slides()[target]?.id;
					const url = id ? `/#${id}` : `/`;
					history.replaceState(null, '', url);
				}
				return;
			}
			/* El DOM es la fuente de verdad tras cualquier gesto o animación. */
			const source = nearestIndex();
			const target = Math.min(slides().length - 1, Math.max(0, source + delta));
			if (goToIndex(target)) {
				navigationDirection = delta;
				const id = slides()[target]?.id;
				const url = id ? `/#${id}` : `/`;
				history.replaceState(null, '', url);
			}
		}

		function workDepth() {
			const work = document.getElementById('work');
			return Number(work?.dataset.depth || 0);
		}

		function isWorkExitWheelGuardActive() {
			const work = document.getElementById('work');
			const until = Number(work?.dataset.wheelExitGuardUntil || 0);
			if (!until) return false;
			if (performance.now() < until) return true;
			work?.removeAttribute('data-wheel-exit-guard-until');
			return false;
		}

		function indexForHash(hash) {
			const id = hash.replace(/^#/, '');
			if (!id) return 0;
			const list = slides();
			const byId = list.findIndex((el) => el.id === id);
			if (byId !== -1) return byId;
			// Proyectos / categorías viven dentro de #work
			if (document.getElementById(id)?.closest('#work')) {
				return list.findIndex((el) => el.id === 'work');
			}
			return -1;
		}

		function routeTarget() {
			const hashId = location.hash.replace(/^#/, '');
			if (hashId) return hashId;

			const queryId = new URLSearchParams(location.search).get('route');
			if (queryId) return decodeURIComponent(queryId);

			const pathId = location.pathname.replace(/^\/+|\/+$/g, '');
			if (pathId) return decodeURIComponent(pathId);

			return '';
		}

		function indexForCurrentRoute() {
			const id = routeTarget();
			if (!id) return 0;
			return indexForHash(`#${id}`);
		}

		function canScrollVertically(el, deltaY) {
			if (!(el instanceof Element)) return false;
			const style = getComputedStyle(el);
			const overflowY = style.overflowY;
			if (overflowY !== 'auto' && overflowY !== 'scroll' && overflowY !== 'overlay') {
				return false;
			}
			const max = el.scrollHeight - el.clientHeight;
			if (max <= 1) return false;
			if (deltaY < 0) return el.scrollTop > 0;
			if (deltaY > 0) return el.scrollTop < max - 1;
			return true;
		}

		function canScrollHorizontally(el, deltaX) {
			if (!(el instanceof Element)) return false;
			const style = getComputedStyle(el);
			const overflowX = style.overflowX;
			if (overflowX !== 'auto' && overflowX !== 'scroll' && overflowX !== 'overlay') {
				return false;
			}
			const max = el.scrollWidth - el.clientWidth;
			if (max <= 1) return false;
			if (deltaX < 0) return el.scrollLeft > 0;
			if (deltaX > 0) return el.scrollLeft < max - 1;
			return true;
		}

		function findScrollableParent(start, deltaY) {
			let node = start instanceof Element ? start : null;
			while (node && node !== container) {
				if (
					node.hasAttribute('data-v-scroll') &&
					canScrollVertically(node, deltaY)
				) {
					return node;
				}
				node = node.parentElement;
			}
			return null;
		}

		function findScrollableParentH(start, deltaX) {
			let node = start instanceof Element ? start : null;
			while (node && node !== container) {
				if (canScrollHorizontally(node, deltaX)) {
					return node;
				}
				node = node.parentElement;
			}
			return null;
		}

		let nestedWheelGestureActive = false;
		let nestedWheelIdleTimer = 0;
		let verticalWheelAccumulator = 0;
		let verticalWheelIdleTimer = 0;
		let verticalWheelBlockedUntil = 0;
		let horizontalWheelAccumulator = 0;
		let horizontalWheelIdleTimer = 0;
		let horizontalWheelBlockedUntil = 0;

		function clearNestedWheelGesture() {
			window.clearTimeout(nestedWheelIdleTimer);
			nestedWheelIdleTimer = 0;
			nestedWheelGestureActive = false;
		}

		function keepNestedWheelGestureOpen() {
			window.clearTimeout(nestedWheelIdleTimer);
			nestedWheelIdleTimer = window.setTimeout(
				clearNestedWheelGesture,
				VERTICAL_WHEEL_IDLE,
			);
		}

		function clearVerticalWheelAccumulator() {
			window.clearTimeout(verticalWheelIdleTimer);
			verticalWheelIdleTimer = 0;
			verticalWheelAccumulator = 0;
		}

		function keepVerticalWheelGestureOpen() {
			window.clearTimeout(verticalWheelIdleTimer);
			verticalWheelIdleTimer = window.setTimeout(
				clearVerticalWheelAccumulator,
				VERTICAL_WHEEL_IDLE,
			);
		}

		function clearHorizontalWheelAccumulator() {
			window.clearTimeout(horizontalWheelIdleTimer);
			horizontalWheelIdleTimer = 0;
			horizontalWheelAccumulator = 0;
		}

		function keepHorizontalWheelGestureOpen() {
			window.clearTimeout(horizontalWheelIdleTimer);
			horizontalWheelIdleTimer = window.setTimeout(
				clearHorizontalWheelAccumulator,
				HORIZONTAL_WHEEL_IDLE,
			);
		}

		container.addEventListener('wheel', (event) => {
			const rawDelta =
				Math.abs(event.deltaY) >= Math.abs(event.deltaX)
					? event.deltaY
					: event.deltaX;
			const deltaScale =
				event.deltaMode === WheelEvent.DOM_DELTA_LINE
					? 16
					: event.deltaMode === WheelEvent.DOM_DELTA_PAGE
						? container.clientWidth
						: 1;
			const primaryDelta = rawDelta * deltaScale;
			if (Math.abs(primaryDelta) < 2) return;
			const isVertical =
				Math.abs(event.deltaY) >= Math.abs(event.deltaX);

			/* Al cerrar una categoría, absorbe su inercia completa para que no
			   dispare una navegación del carrusel padre. */
			if (isWorkExitWheelGuardActive()) {
				event.preventDefault();
				return;
			}

			if (workDepth() > 0) return;

			/* Un gesto vertical inicia una interacción independiente. */
			if (isVertical && horizontalWheelAccumulator) {
				clearHorizontalWheelAccumulator();
			}

			/* About y otros slides tienen capas internas con
			   overscroll-behavior: contain, por lo que el pan nativo no llega al
			   carrusel. En lugar de escribir scrollLeft (que deja posiciones a
			   medias), convertimos el gesto completo en una sola transición con un
			   destino inequívoco. */
			if (!isVertical && !isVerticalLayout()) {
				event.preventDefault();
				clearVerticalWheelAccumulator();
				clearNestedWheelGesture();

				const direction = Math.sign(primaryDelta);
				/* La animación es el único bloqueo persistente. Durante ella solo
				   una inversión puede cambiar el destino; los demás deltas son
				   inercia y se descartan sin dejar estado retenido. */
				if (isScrolling) {
					if (direction === -navigationDirection) go(direction);
					return;
				}

				/* Tras una transición terminada, una ventana mínima absorbe su cola
				   de inercia. A diferencia del antiguo gesto "committed", vence por
				   tiempo absoluto y nunca requiere mover el cursor para liberarse. */
				if (performance.now() < horizontalWheelBlockedUntil) return;

				if (
					horizontalWheelAccumulator &&
					Math.sign(horizontalWheelAccumulator) !== direction
				) {
					horizontalWheelAccumulator = 0;
				}
				horizontalWheelAccumulator += primaryDelta;
				keepHorizontalWheelGestureOpen();
				if (Math.abs(horizontalWheelAccumulator) < WHEEL_THRESHOLD) return;

				const targetDirection = Math.sign(horizontalWheelAccumulator);
				clearHorizontalWheelAccumulator();
				const source = nearestIndex();
				const target = Math.min(
					slides().length - 1,
					Math.max(0, source + targetDirection),
				);
				if (target === source) return;

				horizontalWheelBlockedUntil =
					performance.now() + HORIZONTAL_WHEEL_COOLDOWN;
				go(targetDirection);
				return;
			}

			if (
				isVertical &&
				findScrollableParent(event.target, event.deltaY)
			) {
				nestedWheelGestureActive = true;
				keepNestedWheelGestureOpen();
				return;
			}

			event.preventDefault();
			keepNestedWheelGestureOpen();

			/* No encadenar el final de un scroll vertical con otro salto horizontal. */
			if (nestedWheelGestureActive) return;

			if (performance.now() < verticalWheelBlockedUntil) return;

			if (
				verticalWheelAccumulator &&
				Math.sign(verticalWheelAccumulator) !== Math.sign(primaryDelta)
			) {
				verticalWheelAccumulator = 0;
			}
			verticalWheelAccumulator += primaryDelta;
			keepVerticalWheelGestureOpen();
			if (Math.abs(verticalWheelAccumulator) < WHEEL_THRESHOLD) return;

			/* Hacia abajo (delta positivo) avanza; hacia arriba retrocede. */
			const targetDirection = verticalWheelAccumulator > 0 ? 1 : -1;
			clearVerticalWheelAccumulator();
			const source = nearestIndex();
			const target = Math.min(
				slides().length - 1,
				Math.max(0, source + targetDirection),
			);
			if (target === source) return;

			verticalWheelBlockedUntil =
				performance.now() + VERTICAL_WHEEL_COOLDOWN;
			go(targetDirection);
		}, { passive: false });

		/* ── Touch: un controlador para pan horizontal y swipe vertical ── */
		let touchGesture = null;

		container.addEventListener('touchstart', (event) => {
			if (event.touches.length !== 1) {
				touchGesture = null;
				return;
			}
			const touch = event.touches[0];
			const target = event.target;
			touchGesture = {
				startX: touch.clientX,
				startY: touch.clientY,
				startIndex: nearestIndex(),
				axis: null,
				navigates: false,
				scrollStartTarget: target instanceof Element ? target : null,
			};
		}, { passive: true });

		container.addEventListener('touchmove', (event) => {
			if (!touchGesture || event.touches.length !== 1) return;
			const touch = event.touches[0];
			const dx = touch.clientX - touchGesture.startX;
			const dy = touch.clientY - touchGesture.startY;
			const depth = workDepth();

			if (!touchGesture.axis) {
				if (Math.max(Math.abs(dx), Math.abs(dy)) < TOUCH_INTENT_THRESHOLD) {
					/* Only block horizontal browser-nav gesture if there's no native H scroll target */
					const earlyH = findScrollableParentH(touchGesture.scrollStartTarget, -dx);
					if (!earlyH && Math.abs(dx) > Math.abs(dy) && event.cancelable) event.preventDefault();
					return;
				}
				const scrollTarget = findScrollableParent(touchGesture.scrollStartTarget, -dy);
				const scrollTargetH = findScrollableParentH(touchGesture.scrollStartTarget, -dx);
				touchGesture.hasScrollTarget = !!scrollTarget;
				touchGesture.hasScrollTargetH = !!scrollTargetH;
				if (isVerticalLayout()) {
					touchGesture.axis = Math.abs(dy) >= Math.abs(dx) ? 'y' : 'x';
					touchGesture.navigates =
						touchGesture.axis === 'y' &&
						depth === 0 &&
						!scrollTarget;
				} else {
					touchGesture.axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
					if (touchGesture.axis === 'x') {
						touchGesture.navigates = depth === 0;
					} else {
						touchGesture.navigates = depth === 0 && !scrollTarget;
					}
				}
			}

			/* Block horizontal touches globally UNLESS there's a native H scroll container */
			if (touchGesture.axis === 'x' && !touchGesture.hasScrollTargetH && event.cancelable) event.preventDefault();
			else if (touchGesture.navigates && event.cancelable) event.preventDefault();
		}, { passive: false });

		container.addEventListener('touchend', (event) => {
			if (!touchGesture) {
				return;
			}
			const depth = workDepth();
			if (depth > 0) {
				const gesture = touchGesture;
				touchGesture = null;
				const touch = event.changedTouches[0];
				const dx = touch.clientX - gesture.startX;
				const dy = touch.clientY - gesture.startY;
				
				let shouldForward = false;
				let shouldBack = false;

				if (gesture.axis === 'x' && !gesture.hasScrollTargetH && Math.abs(dx) >= SWIPE_THRESHOLD) {
					if (dx < 0) shouldForward = true;
					else shouldBack = true;
				} else if (gesture.axis === 'y' && !gesture.hasScrollTarget && depth < 3 && Math.abs(dy) >= SWIPE_THRESHOLD) {
					/* En depth 3 (galería de imágenes) el scroll nativo maneja los snap; no interferimos */
					if (dy < 0) shouldForward = true;
					else shouldBack = true;
				}

				if (shouldForward) {
					document.getElementById('work')?.dispatchEvent(new CustomEvent('work:forward'));
				} else if (shouldBack) {
					document.getElementById('work')?.dispatchEvent(new CustomEvent('work:back'));
				}
				return;
			}
			const gesture = touchGesture;
			const touch = event.changedTouches[0];
			const dx = touch.clientX - gesture.startX;
			const dy = touch.clientY - gesture.startY;
			const distance = isVerticalLayout()
				? dy
				: gesture.axis === 'x' ? dx : dy;
			const shouldNavigate =
				gesture.navigates &&
				Math.abs(distance) >= SWIPE_THRESHOLD;
			touchGesture = null;
			if (!shouldNavigate) return;

			/*
			 * Safari y algunos navegadores Android pueden avanzar el scroll nativo
			 * antes de que el touchend llegue. Volvemos al slide donde empezó el
			 * gesto para que animateToSlide siempre tenga distancia que recorrer.
			 */
			const delta = distance < 0 ? 1 : -1;
			/* Durante una transición, go() acepta una inversión y descarta la
			   inercia en la misma dirección; así el touch no queda bloqueado. */
			if (isScrolling) {
				go(delta);
				return;
			}

			const list = slides();
			const startSlide = list[gesture.startIndex];
			const targetIndex = Math.min(
				list.length - 1,
				Math.max(0, gesture.startIndex + delta),
			);
			if (!startSlide || targetIndex === gesture.startIndex) return;

			container.style.scrollSnapType = 'none';
			setScrollPosition(slidePosition(startSlide));
			currentIndex = gesture.startIndex;
			setActiveSlide(currentIndex);

			if (goToIndex(targetIndex)) {
				navigationDirection = delta;
				const id = list[targetIndex]?.id;
				const url = id ? `#${id}` : `${location.pathname}${location.search}`;
				history.replaceState(null, '', url);
			} else {
				container.style.removeProperty('scroll-snap-type');
			}
		}, { passive: true });

		container.addEventListener('touchcancel', () => {
			touchGesture = null;
		}, { passive: true });

		/* ── Keyboard navigation ── */
		window.addEventListener('keydown', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const tag = target.tagName;
			if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
			if (target instanceof HTMLElement && target.isContentEditable) return;

			const isNext = event.key === 'ArrowRight' || event.key === 'ArrowDown';
			const isPrev = event.key === 'ArrowLeft' || event.key === 'ArrowUp';
			if (!isNext && !isPrev) return;
			if (event.repeat) {
				event.preventDefault();
				return;
			}

			const depth = workDepth();
			if (depth > 0) {
				if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') {
					event.preventDefault();
					document.getElementById('work')?.dispatchEvent(new CustomEvent('work:back'));
				} else if (event.key === 'ArrowRight' || event.key === 'ArrowUp') {
					event.preventDefault();
					document.getElementById('work')?.dispatchEvent(new CustomEvent('work:forward'));
				}
				return;
			}

			event.preventDefault();
			go(isNext ? 1 : -1);
		});

		/* ── Navbar / hash → misma navegación horizontal ── */
		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const externalControl = target.closest('[data-external-url]');
			if (externalControl instanceof HTMLElement) {
				const url = externalControl.getAttribute('data-external-url');
				if (!url) return;
				event.preventDefault();
				window.open(url, '_blank', 'noopener,noreferrer');
				return;
			}
			const link = target.closest('a[href^="#"], a[href="/"]');
			if (!(link instanceof HTMLAnchorElement)) return;
			const href = link.getAttribute('href');
			if (!href || href === '#') return;

			let idx = 0;
			if (href !== '/') {
				idx = indexForHash(href);
				if (idx < 0) return;
			}

			event.preventDefault();
			if (workDepth() > 0 && href !== '#work' && href !== '/') {
				document.getElementById('work')?.dispatchEvent(new CustomEvent('work:close'));
			}
			goToIndex(idx);
			history.replaceState(null, '', href === '/' ? '/' : `/${href}`);
		});

		container.addEventListener('scroll', () => {
			const idx = nearestIndex();
			if (!isScrolling) currentIndex = idx;
			/* Durante el swipe, activar cuando el slide ya es el más cercano */
			setActiveSlide(idx);
		}, { passive: true });

		container.addEventListener('scrollend', () => {
			if (isScrolling) {
				if (!navigationFrame) finishNavigation();
				return;
			}
			currentIndex = nearestIndex();
			setActiveSlide(currentIndex);
		}, { passive: true });

		/* ── Scroll hint: hide on first interaction ── */
		const scrollHint = document.querySelector('.scroll-hint');
		if (scrollHint) {
			const hideHint = () => {
				scrollHint.classList.add('is-hidden');
				container.removeEventListener('scroll', hideHint);
				window.removeEventListener('keydown', hideHint);
			};
			scrollHint.addEventListener('click', () => go(1));
			container.addEventListener('scroll', hideHint, { once: true });
			window.addEventListener('keydown', hideHint, { once: true });
		}

		currentIndex = nearestIndex();
		const initialRouteIndex = indexForCurrentRoute();
		if (initialRouteIndex >= 0) {
			const list = slides();
			const slide = list[initialRouteIndex];
			if (slide) {
				currentIndex = initialRouteIndex;
				if (isVerticalLayout()) {
					container.scrollTo({ top: slide.offsetTop, behavior: 'instant' });
				} else {
					container.scrollTo({ left: slide.offsetLeft, behavior: 'instant' });
				}
			}
		}

		mobileLayoutQuery.addEventListener('change', () => {
			requestAnimationFrame(() => {
				const slide = slides()[currentIndex];
				if (slide) setScrollPosition(slidePosition(slide));
			});
		});

		/* Primero pinta el estado inicial (opacity 0), luego activa el fade-up */
		slides().forEach((slide) => {
			slide.classList.remove('is-active');
			slide.removeAttribute('data-active');
		});

		if (prefersReducedMotion) {
			setActiveSlide(currentIndex);
		} else {
			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					setActiveSlide(currentIndex);
				});
			});
		}

	}
</script>

