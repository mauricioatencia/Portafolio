---
import homeData from "../content/home.json";
import aboutData from "../content/about.json";
import siteSettings from "../content/site_settings.json";
import {
	getMediaDeliveryUrl,
	getMobileHeroPosterUrl,
	getVideoPosterUrl,
	isVideoMedia,
} from "../utils/media";

const heroMedia =
	homeData.hero_media ||
	(homeData as { hero_image?: string }).hero_image ||
	"";
const deliveredHeroMedia = getMediaDeliveryUrl(heroMedia);
const isHeroVideo = isVideoMedia(heroMedia);
const aboutImage = aboutData.image || "";
const logoImage = siteSettings.logo_image || "";
const faviconSrc = (siteSettings as { favicon?: string }).favicon || "";
const siteUrl = "https://mauricioatencia.com";
// Las redes no reproducen el video del hero; usan esta imagen como su preview.
const homePreviewImage = isHeroVideo
	? getVideoPosterUrl(heroMedia) || `${siteUrl}/hero-poster.jpg`
	: deliveredHeroMedia
		? /^https?:\/\//i.test(deliveredHeroMedia)
			? deliveredHeroMedia
			: `${siteUrl}${deliveredHeroMedia}`
		: `${siteUrl}/hero-poster.jpg`;
const heroPoster = getVideoPosterUrl(heroMedia) || `${siteUrl}/hero-poster.jpg`;
const mobileHeroPoster = getMobileHeroPosterUrl(heroMedia);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		{
			faviconSrc ? (
				<link rel="icon" href={faviconSrc} />
			) : (
				<>
					<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
					<link rel="icon" href="/favicon.ico" />
				</>
			)
		}
		<meta name="generator" content={Astro.generator} />
		<title>Mauricio Atencia — Portfolio</title>
		<!-- Open Graph base -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={`${siteUrl}/`} />
		<meta property="og:title" content="Mauricio Atencia — Portfolio" />
		<meta
			property="og:description"
			content="Portfolio de diseño gráfico de Mauricio Atencia — Branding, Social Media, Flyers y Merch."
		/>
		<meta property="og:image" content={homePreviewImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1920" />
		<meta property="og:image:height" content="1080" />
		<meta property="og:site_name" content="Mauricio Atencia" />
		<meta property="og:locale" content="es_CO" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Mauricio Atencia — Portfolio" />
		<meta
			name="twitter:description"
			content="Portfolio de diseño gráfico de Mauricio Atencia — Branding, Social Media, Flyers y Merch."
		/>
		<meta name="twitter:image" content={homePreviewImage} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;600&display=swap"
			rel="stylesheet"
		/>
		{
			heroMedia && !isHeroVideo && (
				<link
					rel="preload"
					as="image"
					href={deliveredHeroMedia}
					fetchpriority="high"
				/>
			)
		}
		{
			heroMedia && isHeroVideo && (
				<>
					<link
						rel="preload"
						as="image"
						href={heroPoster}
						media="(min-width: 701px)"
						fetchpriority="high"
					/>
					<link
						rel="preload"
						as="image"
						href={mobileHeroPoster || heroPoster}
						media="(max-width: 700px)"
						fetchpriority="high"
					/>
				</>
			)
		}
		{
			aboutImage && (
				<link
					rel="preload"
					as="image"
					href={aboutImage}
					fetchpriority="high"
				/>
			)
		}
		{
			logoImage && (
				<link
					rel="preload"
					as="image"
					href={logoImage}
					fetchpriority="high"
				/>
			)
		}
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
	</head>
	<body>
		<a href="#about" class="skip-link">Saltar al contenido</a>
		<slot />
		<div class="site-cursor" aria-hidden="true"></div>
	</body>
</html>

<script>
	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	const cursor = document.querySelector(".site-cursor") as HTMLElement | null;
	const supportsFinePointer = window.matchMedia(
		"(any-pointer: fine)",
	).matches;
	const prefersReducedCursorMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	if (cursor && supportsFinePointer && !prefersReducedCursorMotion) {
		const root = document.documentElement;
		const interactiveSelector = [
			"a[href]",
			"button:not([disabled]):not(.project-row)",
			"input:not([disabled])",
			"textarea:not([disabled])",
			"select:not([disabled])",
			'[role="button"]',
			"[data-cursor-interactive]",
		].join(",");

		let x = -40;
		let y = -40;
		let targetX = x;
		let targetY = y;
		let frame = 0;

		const paint = () => {
			x += (targetX - x) * 0.72;
			y += (targetY - y) * 0.72;
			cursor.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%) scale(var(--cursor-scale))`;

			if (Math.abs(targetX - x) > 0.1 || Math.abs(targetY - y) > 0.1) {
				frame = window.requestAnimationFrame(paint);
			} else {
				frame = 0;
			}
		};

		const queuePaint = () => {
			if (!frame) frame = window.requestAnimationFrame(paint);
		};

		const hideCursor = () => cursor.classList.remove("is-visible");

		root.classList.add("has-custom-cursor");
		document.addEventListener("pointermove", (event) => {
			if (event.pointerType && event.pointerType !== "mouse") return;
			targetX = event.clientX;
			targetY = event.clientY;
			cursor.classList.add("is-visible");
			const target = event.target;
			const isInteractive =
				target instanceof Element &&
				Boolean(target.closest(interactiveSelector));
			const isNav =
				target instanceof Element &&
				Boolean(target.closest(".navbar a, [data-cursor-nav]"));

			cursor.classList.toggle("is-hovering", isInteractive && !isNav);
			cursor.classList.toggle("is-hovering-nav", isNav);
			queuePaint();
		});

		document.addEventListener("pointerdown", () =>
			cursor.classList.add("is-pressing"),
		);
		document.addEventListener("pointerup", () =>
			cursor.classList.remove("is-pressing"),
		);
		document.documentElement.addEventListener("mouseleave", hideCursor);
		window.addEventListener("blur", hideCursor);
	}
</script>

<style is:global>
	@font-face {
		font-family: "Aptos";
		src: url("/fonts/Aptos%20font/Aptos-SemiBold.ttf") format("truetype");
		font-weight: 600;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Acumin Variable Concept";
		src: url("/fonts/AcuminVariableConcept.otf") format("opentype");
		font-weight: 100 900;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Helvetica43";
		src: url("/fonts/Helvetica43-ExtendedLight%20Light.ttf")
			format("truetype");
		font-weight: 300;
		font-style: normal;
		font-display: swap;
	}

	:root {
		--font-nav: "Aptos", "Inter", sans-serif;
		--font-text: "Acumin Variable Concept", "Inter", sans-serif;
		--font-helvetica: "Helvetica43", "Inter", sans-serif;

		/* Safe areas (notch / status bar / home indicator) */
		--sat: env(safe-area-inset-top, 0px);
		--sar: env(safe-area-inset-right, 0px);
		--sab: env(safe-area-inset-bottom, 0px);
		--sal: env(safe-area-inset-left, 0px);

		/* Espaciado base (sin safe-area) */
		--pad-header-y-base: clamp(0.65rem, 2.2vh, 1.5rem);
		--pad-header-x-r-base: clamp(1rem, 3vw, 3rem);
		--pad-header-x-l-base: clamp(0.85rem, 2vw, 2rem);
		--pad-section-x-base: clamp(1rem, 3vw, 4rem);
		--pad-section-b-base: clamp(1rem, 3.2vh, 3rem);

		/* Espaciado compartido + safe-area */
		--pad-header-y: calc(var(--pad-header-y-base) + var(--sat));
		--pad-header-x-r: calc(var(--pad-header-x-r-base) + var(--sar));
		--pad-header-x-l: calc(var(--pad-header-x-l-base) + var(--sal));
		--pad-section-x: var(--pad-section-x-base);
		--pad-section-x-l: calc(var(--pad-section-x-base) + var(--sal));
		--pad-section-x-r: calc(var(--pad-section-x-base) + var(--sar));
		--pad-section-b: calc(var(--pad-section-b-base) + var(--sab));
		--nav-gap: clamp(1.25rem, 5.5vw, 8.5rem);
		--nav-size: clamp(0.8rem, 1.15vw, 1.7rem);
		--logo-w: clamp(96px, 14.75vw, 283px);

		/* Motion — un mismo ritmo, con entradas firmes y salida suave. */
		--ease-out: cubic-bezier(0.16, 1, 0.3, 1);
		--ease-inout: cubic-bezier(0.65, 0, 0.35, 1);
		--dur-fast: 0.28s;
		--dur-split: 1.5s; /* separación del nombre: debe coincidir con SPLIT_MS del script */
		--dur-med: 0.72s;
		--dur-slow: 1.2s;
		--dur-panel: 0.8s; /* apertura del cuadrado: debe coincidir con PANEL_MS del script */
		--ease-square: cubic-bezier(
			0.76,
			0,
			0.24,
			1
		); /* simétrica, movimiento repartido en todo el trayecto, no concentrado al inicio */
	}

	/*
	 * En muchos móviles env(safe-area-*) llega en 0 aunque haya status bar / notch.
	 * Forzamos mínimos en táctil; en landscape el inset lateral suele ser el crítico.
	 */
	@media (hover: none) {
		:root {
			--sat: max(env(safe-area-inset-top, 0px), 16px);
			--sab: max(env(safe-area-inset-bottom, 0px), 12px);
			--sal: max(env(safe-area-inset-left, 0px), 16px);
			--sar: max(env(safe-area-inset-right, 0px), 16px);
		}
	}

	@media (hover: none) and (orientation: landscape) {
		:root {
			/* En horizontal, la isla/notch queda en los laterales. El
			   encabezado usa solo el inset superior real, no un mínimo
			   artificial que desalineaba About del resto de secciones. */
			--sat: env(safe-area-inset-top, 0px);
			--sab: max(env(safe-area-inset-bottom, 0px), 12px);
			--sal: max(env(safe-area-inset-left, 0px), 36px);
			--sar: max(env(safe-area-inset-right, 0px), 36px);
			/* Este es el ritmo vertical que ya tenía About en móvil.
			   Al vivir aquí, inicio, Work y contacto resuelven el mismo
			   --pad-header-y y sus navbars quedan alineadas. */
			--pad-header-y-base: clamp(0.4rem, 2vh, 0.75rem);
		}
	}

	/* En pantallas grandes se conservan los mínimos originales */
	@media (min-width: 1200px) {
		:root {
			--nav-gap: clamp(5rem, 5.5vw, 8.5rem);
			--nav-size: clamp(1.05rem, 1.15vw, 1.7rem);
			--logo-w: clamp(160px, 14.75vw, 283px);
			--pad-header-y-base: clamp(1rem, 2.2vh, 1.5rem);
		}
	}

	@media (min-width: 1200px) and (hover: hover) {
		:root {
			--sat: env(safe-area-inset-top, 0px);
			--sar: env(safe-area-inset-right, 0px);
			--sab: env(safe-area-inset-bottom, 0px);
			--sal: env(safe-area-inset-left, 0px);
		}
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
		height: 100dvh;
		background-color: #050505;
		color: #ffffff;
		overflow: hidden;
		overscroll-behavior-x: none;
		overscroll-behavior-y: none;
	}

	html.has-custom-cursor,
	html.has-custom-cursor * {
		cursor: none !important;
	}

	html.orientation-locked,
	body.orientation-locked {
		overflow: hidden;
		touch-action: none;
	}

	body.orientation-locked > :not(.rotate-device):not(.skip-link) {
		visibility: hidden !important;
		pointer-events: none !important;
	}

	a {
		color: inherit;
		text-decoration: none;
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	a:hover {
		opacity: 0.7;
	}

	/* Revelado editorial compartido: el contenido aparece desde una máscara,
	   no únicamente por opacidad. */
	.reveal {
		opacity: 0;
		clip-path: inset(0 0 100% 0);
		transform: translate3d(0, 1.15rem, 0);
		transition:
			opacity 80ms linear,
			clip-path var(--dur-med) var(--ease-out),
			transform var(--dur-med) var(--ease-out);
		transition-delay: var(--reveal-delay, 0ms);
		will-change: opacity, transform;
	}

	.is-active > .reveal,
	.is-active .reveal {
		opacity: 1;
		clip-path: inset(0 0 0 0);
		transform: translate3d(0, 0, 0);
	}

	html:not(.js) .reveal {
		opacity: 1;
		clip-path: none;
		transform: none;
		transition: none;
	}

	.site-loader {
		position: fixed;
		inset: 0;
		z-index: 20000;
		display: grid;
		place-items: center;
		padding: max(1rem, var(--sat)) max(1rem, var(--sar))
			max(1rem, var(--sab)) max(1rem, var(--sal));
		/* El negro ya no lo pone este contenedor: lo dan los 4
		   .site-loader__bar de abajo, así se puede "abrir" un hueco
		   real en el centro sin depender de clip-path con geometría
		   auto-intersectada (eso causaba un destello de triángulo en
		   algunos navegadores durante la transición). */
		background: transparent;
		color: #eeedec;
		overflow: hidden;
	}

	/*
	 * Un ÚNICO cuadrado que se abre desde el centro hacia afuera, con 4
	 * barras tipo "marco de foto" (arriba, abajo, izquierda, derecha).
	 *
	 * En reposo, la barra de arriba cubre la mitad superior de la
	 * pantalla y la de abajo la mitad inferior (juntas = pantalla
	 * completa, izquierda/derecha quedan con altura 0, invisibles).
	 *
	 * Al agregar .is-leaving, arriba/abajo encogen su altura hacia 0 (su
	 * borde se aleja del centro) mientras izquierda/derecha crecen para
	 * rellenar el hueco vertical y encogen su ancho hacia 0. El
	 * resultado es que el hueco revelado es SIEMPRE un único rectángulo
	 * centrado que crece parejo en las 4 direcciones — no 4 piezas
	 * sueltas volando a las esquinas.
	 */
	.site-loader__bar {
		position: absolute;
		background: #050505;
		transition:
			top var(--dur-panel) var(--ease-square),
			height var(--dur-panel) var(--ease-square),
			width var(--dur-panel) var(--ease-square);
	}

	.site-loader__bar--top {
		top: 0;
		left: 0;
		width: 100%;
		height: 50%;
	}

	.site-loader__bar--bottom {
		bottom: 0;
		left: 0;
		width: 100%;
		height: 50%;
	}

	.site-loader__bar--left {
		top: 50%;
		left: 0;
		width: 50%;
		height: 0%;
	}

	.site-loader__bar--right {
		top: 50%;
		right: 0;
		width: 50%;
		height: 0%;
	}

	.site-loader.is-leaving .site-loader__bar--top,
	.site-loader.is-leaving .site-loader__bar--bottom {
		height: 0%;
	}

	.site-loader.is-leaving .site-loader__bar--left,
	.site-loader.is-leaving .site-loader__bar--right {
		top: 0%;
		height: 100%;
		width: 0%;
	}

	.site-loader.is-leaving {
		pointer-events: none;
	}

	html:not(.js) .site-loader {
		display: none;
	}

	.site-loader[hidden],
	.site-loader.is-complete {
		display: none;
	}

	.site-loader__title {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		font-family: var(--font-nav);
		font-weight: 600;
		font-size: clamp(3.5rem, 12vw, 14rem);
		line-height: 0.79;
		letter-spacing: -0.022em;
		-webkit-text-stroke: clamp(1px, 0.07vw, 2px) currentColor;
	}

	.site-loader__line {
		display: block;
		/* --ease-square (en vez de --ease-out) reparte el movimiento a lo
		   largo de todo el trayecto en vez de concentrarlo al arrancar,
		   así se percibe como un desplazamiento y no como un salto. */
		transition: transform var(--dur-split) var(--ease-square);
		will-change: transform;
	}

	.site-loader.is-splitting .site-loader__line--mauricio {
		transform: translate3d(-115vw, 0, 0);
	}

	.site-loader.is-splitting .site-loader__line--atencia {
		transform: translate3d(115vw, 0, 0);
	}

	.site-cursor {
		--cursor-scale: 1;
		position: fixed;
		top: 0;
		left: 0;
		z-index: 10000;
		width: 9px;
		height: 9px;
		border: 1px solid #ffffff;
		border-radius: 999px;
		background: #ffffff;
		mix-blend-mode: difference;
		pointer-events: none;
		opacity: 0;
		transform: translate3d(-40px, -40px, 0) translate(-50%, -50%)
			scale(var(--cursor-scale));
		transition:
			opacity 140ms ease,
			width var(--dur-fast) var(--ease-out),
			height var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out);
		will-change: transform, width, height;
	}

	.site-cursor.is-visible {
		opacity: 1;
	}

	.site-cursor.is-hovering {
		--cursor-scale: 1.5;
	}

	.site-cursor.is-hovering-nav {
		width: 50px;
		height: 50px;
		--cursor-scale: 1;
	}

	.site-cursor.is-pressing {
		--cursor-scale: 0.72;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-loader {
			display: none;
		}

		.reveal {
			opacity: 1;
			clip-path: none;
			transform: none;
			transition: none;
		}

		.site-cursor {
			display: none;
		}
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	* {
		box-sizing: border-box;
	}

	.skip-link {
		position: fixed;
		top: -100%;
		left: calc(1rem + var(--sal));
		z-index: 9999;
		padding: 0.75rem 1.25rem;
		background: #000000;
		color: #ffffff;
		font-family: var(--font-nav);
		font-weight: 600;
		font-size: 1rem;
		border-radius: 0 0 6px 6px;
		opacity: 1;
		transition: top 0.2s ease;
	}

	.skip-link:focus {
		top: var(--sat);
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>
